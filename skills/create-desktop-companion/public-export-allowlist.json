    "ASSET-POLICY.zh-CN.md",
    "SOURCE-CREDITS.md",
    "SOURCE-CREDITS.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "public-export-allowlist.json",
    "scripts",
    "tests",
    "templates",
    "examples",
    "docs",
    "assets",
    "tools",
    ".gitignore"
  ],
  "allowed_binary_assets": [
